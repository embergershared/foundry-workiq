{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "subscriptionCode": {
      "value": "${AZURE_SUBSCRIPTION_CODE}"
    },
    "deploymentProfile": {
      "value": "${DEPLOYMENT_PROFILE=core}"
    },
    "repository": {
      "value": "${AZURE_REPOSITORY}"
    },
    "featureOverridesBase64": {
      "value": "${AZURE_FEATURE_OVERRIDES_BASE64}"
    },
    "operatorPrincipalIdsCsv": {
      "value": "${AZURE_OPERATOR_PRINCIPAL_IDS}"
    },
    "workIqUsersGroupId": {
      "value": "${WORKIQ_USERS_GROUP_ID}"
    },
    "deployerPrincipalId": {
      "value": "${AZURE_PRINCIPAL_ID}"
    },
    "deployerPrincipalType": {
      "value": "${AZURE_PRINCIPAL_TYPE=User}"
    },
    "apiManagementPublisherEmail": {
      "value": "${AZURE_APIM_PUBLISHER_EMAIL}"
    },
    "apiManagementSku": {
      "value": "${AZURE_APIM_SKU=BasicV2}"
    },
    "managedRedisSku": {
      "value": "${AZURE_REDIS_SKU=Balanced_B0}"
    },
    "managedRedisHighAvailability": {
      "value": "${AZURE_REDIS_HIGH_AVAILABILITY=Enabled}"
    },
    "createdOn": {
      "value": "${AZURE_CREATED_ON}"
    },
    "lastUpdatedOn": {
      "value": "${AZURE_LAST_UPDATED_ON}"
    }
  }
}
