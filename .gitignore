# Squad: ignore runtime state (logs, inbox, sessions)
.squad/orchestration-log/
.squad/log/
.squad/decisions/inbox/
.squad/sessions/
.squad/.scratch/
.squad/.cache/
# Squad: SubSquad activation file (local to this machine)
.squad-workstream
# Squad upgrades keep the replaced files as local backups
*.local-backup

# Azure Developer CLI local environment state and generated artifacts
.azure/*/
.env
.env.*
!.env.example
*.bicep.cache
infra/*.jsonc

# AZD local state and generated artifacts
.azure/**
.azure/.gitignore
!.azure/deployment-plan.md

# This repository's tenant and subscription IDs stay local. A fresh clone and CI
# start from the .example files: run ./scripts/init-from-template.ps1.
infra/core/tenant-codes.json
docs/targets.md

# Compiled ARM output. azd and az compile infra/main.bicep directly, so a
# committed copy has no consumer and silently goes stale.
infra/main.json
